# Copy to .env and adjust. Consumed by docker-compose.yml.

# GeoServer admin credentials (used by the geoserver service and the WPS
# handlers in tools/easyows.py to publish model outputs).
GEOSERVER_USER=admin
GEOSERVER_PASS=geoserver

# Host port overrides (container ports are unchanged). Set these if the defaults
# collide with other stacks on the host. GEOSERVER_HOST_PORT also determines the
# GeoServer URL the WPS advertises to clients for published layers.
WPS_HOST_PORT=5000
DASHBOARD_HOST_PORT=8000
FILESERVER_HOST_PORT=8001
GEOSERVER_HOST_PORT=8080

# Results layout on the destination server (see docsrc/rasters.rst):
#   run    - a workspace per run; layer names stay as the model wrote them
#   series - one layer per model output, one granule per run, addressed by time
ESWS_RESULTS_LAYOUT=run

# Where published vectors live: files (shapefiles) or postgis.
# ESWS_RESULTS_LAYOUT=series needs postgis for vectors.
ESWS_VECTOR_BACKEND=files

POSTGIS_DB=esws
POSTGIS_USER=esws
POSTGIS_PASS=esws
