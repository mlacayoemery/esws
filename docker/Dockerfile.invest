# ESWS WPS server image — InVEST 3.20.0 on a conda-forge GDAL base.
#
# Mirrors the NatCap approach (natcap/invest-compute startup_script.sh): bring in
# Python + GDAL (+ build tooling for InVEST's Cython extensions) from conda-forge,
# then pip-install the rest of the stack against that GDAL.
#
# Shared by the `wps` and `fileserver` compose services.
FROM mambaorg/micromamba:1.5.8

# Install requirements file early for better layer caching.
COPY --chown=$MAMBA_USER:$MAMBA_USER requirements/server.txt /tmp/server.txt

# Python 3.11 + GDAL 3.x + compilers/cython so `pip install natcap.invest` can
# build its extensions from sdist if no wheel is available for this platform.
RUN micromamba install -y -n base -c conda-forge \
        python=3.11 \
        "gdal=3.10.*" \
        c-compiler \
        cxx-compiler \
        cython \
        numpy \
        "pygeoprocessing>=2.4.10" \
        setuptools \
        setuptools_scm \
        wheel \
        pip \
        babel && \
    micromamba clean --all --yes

# Activate the base env for the remaining RUN steps (and at container runtime via
# the micromamba entrypoint).
ARG MAMBA_DOCKERFILE_ACTIVATE=1

# InVEST publishes no Linux wheels, so it builds from sdist here. Its build
# requirements include pygeoprocessing, and in pip's *isolated* build
# environment that resolves the newest GDAL bindings off PyPI -- which then
# refuse to build ("Python bindings of GDAL 3.13.2 require at least libgdal
# 3.13.2, but 3.10.3 was found"). InVEST deliberately keeps GDAL out of its own
# build requirements for exactly this reason, so build it against the
# conda-forge stack above instead of an isolated one. Everything else installs
# normally; natcap.invest is already satisfied by then.
RUN pip install --no-cache-dir --no-build-isolation natcap.invest==3.20.0 && \
    pip install --no-cache-dir -r /tmp/server.txt

# pywps writes stored ExecuteResponse documents and referenced outputs here
# (outputpath in tools/wpsserver/pywps.cfg). Create it as the image user so the
# named volume compose mounts over it inherits that ownership: Docker seeds an
# empty volume from the image directory it covers. Without this the volume comes
# out root-owned, the container runs as mambauser, and every asynchronous
# request fails with "Writing Response Document failed with : [Errno 13]
# Permission denied" -- so storeExecuteResponse and asReference are advertised
# but unusable.
RUN mkdir -p /tmp/wpsoutputs

# Application code (compose also bind-mounts ./ over /app for live editing).
COPY --chown=$MAMBA_USER:$MAMBA_USER . /app
WORKDIR /app

# Upload target for table outputs, shared with the fileserver as a named volume.
# Created here for the same ownership reason as /tmp/wpsoutputs above -- and it
# has to be after the COPY, which would otherwise replace the directory.
RUN mkdir -p /app/data/results

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/tools

# pywps Flask server (tools/wpsserver/wpsserver.py binds 0.0.0.0:5000).
EXPOSE 5000
CMD ["python", "tools/wpsserver/wpsserver.py"]
